    "import math\n",
    "\n",
    "def phi_naive(n):\n",
    "    \"\"\"\n",
    "    정의 그대로 구현: 1부터 n까지 gcd가 1인 개수를 셈\n",
    "    시간복잡도: O(N log N)\n",
    "    \"\"\"\n",
    "    count = 0\n",
    "    coprimes = []\n",
    "    \n",
    "    for i in range(1, n + 1):\n",
    "        if math.gcd(n, i) == 1: # 최대공약수가 1이면 서로소\n",
    "            count += 1\n",
    "            coprimes.append(i)\n",
    "            \n",
    "    return count, coprimes\n",
    "\n",
    "# 테스트: n = 10일 때\n",
    "# 1, 3, 7, 9 가 10과 서로소임 -> 답은 4\n",
    "n = 10\n",
    "count, numbers = phi_naive(n)\n",
    "print(f\"phi({n}) = {count}\")\n",
    "print(f\"서로소인 수들: {numbers}\")"
   ]
