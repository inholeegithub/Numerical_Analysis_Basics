    "\n",
    "def kahan_sum(xs):\n",
    "    s = 0.0\n",
    "    c = 0.0\n",
    "    for x in xs:\n",
    "        y = x - c\n",
    "        t = s + y\n",
    "        c = (t - s) - y\n",
    "        s = t\n",
    "    return s\n",
    "\n",
    "import numpy as np\n",
    "# Generate an array of numbers with high precision issues\n",
    "xs = np.array([1e16, 1, -1e16])\n",
